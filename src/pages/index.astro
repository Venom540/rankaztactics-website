---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

// Fetch latest 3 blog posts (non-draft, sorted by date)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stats = [
  { value: '100+', label: 'Brands Scaled' },
  { value: '#1', label: 'Rankings Achieved' },
  { value: '3.2×', label: 'Average ROAS' },
  { value: '48h', label: 'Avg. Onboarding' },
];

const services = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Keyword Ranking',
    desc: 'Data-driven keyword targeting that gets you to page 1 and keeps you there.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Listing Optimization',
    desc: 'Titles, bullets, A+ content, and imagery engineered for maximum conversion.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>`,
    title: 'PPC Management',
    desc: 'Full-funnel advertising that cuts wasted spend and scales profitable keywords.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>`,
    title: 'Profitability Audit',
    desc: 'We dig into your unit economics and find hidden margin leaks across your catalog.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Brand Protection',
    desc: 'Monitor hijackers, protect your Buy Box, and defend your brand reputation.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
    title: 'Launch Strategy',
    desc: 'End-to-end product launch plans with ranking velocity built in from day one.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10l4.553-2.069A1 1 0 0 1 21 8.87V15.13a1 1 0 0 1-1.447.9L15 14M3 8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z"/></svg>`,
    title: 'UGC Ads',
    desc: 'Authentic user-generated content ads that drive trust, engagement, and conversions at scale.',
  },
];
---

<BaseLayout
  title="Rankaztactics — Amazon Ranking & Profitability Agency"
  description="Rankaztactics helps Amazon sellers dominate search rankings, maximize ROI, and scale with confidence. Book a free strategy call today."
>

  <!-- ============================================================
       SECTION 1: HERO
       ============================================================ -->
  <section class="hero section" id="home" aria-label="Hero">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--1" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--2" aria-hidden="true"></div>

    <div class="container">
      <div class="hero__content">
        <!-- Badge -->
        <div class="section-tag animate-fade-up">
          <span>Amazon Growth Agency</span>
        </div>

        <!-- Headline -->
        <h1 class="hero__headline animate-fade-up-delay-1">
          Rank Higher.<br />
          <em class="text-gradient">Profit More.</em>
        </h1>

        <!-- Subheadline -->
        <p class="hero__sub animate-fade-up-delay-2">
          Rankaztactics is the data-obsessed Amazon agency that turns underperforming listings into category leaders.
          We build ranking systems, not just campaigns.
        </p>

        <!-- CTAs -->
        <div class="hero__actions animate-fade-up-delay-3">
          <a href="#calendly" class="btn-primary" id="hero-cta-book">
            <span>Book a Free Strategy Call</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/blog" class="btn-secondary" id="hero-cta-blog">
            Read Our Blog
          </a>
        </div>

        <!-- Stats Bar -->
        <div class="hero__stats animate-fade-up-delay-4">
          {stats.map((s) => (
            <div class="hero__stat">
              <span class="hero__stat-value">{s.value}</span>
              <span class="hero__stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Video Embed -->
      <div class="hero__video animate-fade-up-delay-3">
        <div class="hero__video-wrapper">
          <!--
            ✅ YOUTUBE EMBED INSTRUCTIONS:
            Replace the src attribute below with your YouTube video embed URL.
            Format: https://www.youtube.com/embed/YOUR_VIDEO_ID
            Example: https://www.youtube.com/embed/dQw4w9WgXcQ
            Optional parameters: ?autoplay=1&mute=1&loop=1&playlist=YOUR_VIDEO_ID
          -->
          <iframe
            src="https://www.youtube.com/embed/VD5clg4od7A?si=2vvL0R-00zbU6RKz&rel=0&modestbranding=1"
            title="Rankaztactics — How We Rank Amazon Products"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="hero__video-glow" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SERVICES STRIP
       ============================================================ -->
  <section class="services section-sm" id="services" aria-label="Services">
    <div class="container">
      <div class="services__header">
        <div class="section-tag">What We Do</div>
        <h2>Everything You Need to<br /><span class="text-gradient">Dominate Amazon</span></h2>
        <p class="services__sub">
          From keyword research to PPC management, we handle every piece of the Amazon growth puzzle — so you can focus on building your brand.
        </p>
      </div>
      <div class="services__grid">
        {services.map((s, i) => (
          <div class={`service-card card animate-fade-up-delay-${Math.min(i + 1, 4)}`}>
            <div class="service-card__icon" set:html={s.icon} />
            <h3 class="service-card__title">{s.title}</h3>
            <p class="service-card__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: MEET THE TEAM
       ============================================================ -->
  <section class="team-section section" id="team" aria-label="Meet the team">
    <div class="container">
      <div class="team__header">
        <div class="section-tag">Our People</div>
        <h2>Meet the <span class="text-gradient">Team</span></h2>
        <p class="team__sub">The experts behind your Amazon growth.</p>
      </div>

      <div class="team__grid">
        <!-- Zayeem Afzal -->
        <div class="team-card card">
          <div class="team-card__photo-wrap">
            <img src="/team/zayeem.jpg" alt="Zayeem Afzal" class="team-card__photo" loading="lazy" />
          </div>
          <div class="team-card__body">
            <h3 class="team-card__name">Zayeem Afzal</h3>
            <span class="team-card__title">CEO</span>
            <p class="team-card__desc">In charge of making custom strategies for PPC, Branding, and Design.</p>
          </div>
        </div>

        <!-- Areeba -->
        <div class="team-card card">
          <div class="team-card__photo-wrap">
            <img src="/team/areeba.png" alt="Areeba" class="team-card__photo" loading="lazy" />
          </div>
          <div class="team-card__body">
            <h3 class="team-card__name">Areeba</h3>
            <span class="team-card__title">Client Management</span>
          </div>
        </div>

        <!-- Iqra Bashir -->
        <div class="team-card card">
          <div class="team-card__photo-wrap">
            <img src="/team/iqra.jpg" alt="Iqra Bashir" class="team-card__photo" loading="lazy" />
          </div>
          <div class="team-card__body">
            <h3 class="team-card__name">Iqra Bashir</h3>
            <span class="team-card__title">CFO</span>
            <p class="team-card__desc">In charge of Operations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 2: CALENDLY CTA
       ============================================================ -->
  <section class="calendly-section section" id="calendly" aria-label="Book a strategy call">
    <div class="container">
      <div class="calendly__layout">
        <!-- Left: Text -->
        <div class="calendly__text">
          <div class="section-tag">Free Strategy Call</div>
          <h2>
            Ready to Scale?<br />
            <span class="text-gradient">Let's Talk Strategy.</span>
          </h2>
          <p class="calendly__sub">
            Book a free 30-minute strategy call with our Amazon growth experts. We'll analyze your current listings, uncover ranking opportunities, and build a roadmap specific to your brand.
          </p>

          <ul class="calendly__benefits">
            {[
              'No commitment, no sales pressure',
              'Live keyword and competitor audit',
              'Custom ranking roadmap',
              'Profitability breakdown for your top ASINs',
            ].map((b) => (
              <li class="calendly__benefit">
                <span class="calendly__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                {b}
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Calendly Embed -->
        <div class="calendly__embed">
          <!-- Calendly inline widget begin -->
          <div
            class="calendly-inline-widget"
            data-url="https://calendly.com/iqrazayeem/30min?hide_event_type_details=1"
            style="min-width:320px;height:700px;"
          ></div>
          <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
          <!-- Calendly inline widget end -->
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 3: BLOG PREVIEW
       ============================================================ -->
  <section class="blog-preview section" id="blog" aria-label="Latest from the blog">
    <div class="container">
      <div class="blog-preview__header">
        <div>
          <div class="section-tag">Amazon Insights</div>
          <h2>
            From the <span class="text-gradient">Rankaztactics Blog</span>
          </h2>
          <p class="blog-preview__sub">
            Actionable strategies, deep dives, and case studies to help you rank higher and profit more on Amazon.
          </p>
        </div>
        <a href="/blog" class="btn-secondary blog-preview__all-link" id="blog-view-all-btn">
          View All Posts
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="grid-3" role="list">
        {latestPosts.map((post) => (
          <div role="listitem">
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              author={post.data.author}
              category={post.data.category}
              slug={post.slug}
              readTime={post.data.readTime}
            />
          </div>
        ))}
      </div>

      <div class="blog-preview__cta">
        <a href="/blog" class="btn-primary" id="blog-see-more-btn">
          <span>See All Articles</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 4: CONTACT / TALLY
       ============================================================ -->
  <section class="contact-section section" id="contact" aria-label="Contact Rankaztactics">
    <div class="container">
      <div class="contact__layout">
        <!-- Left: Text -->
        <div class="contact__text">
          <div class="section-tag">Get In Touch</div>
          <h2>
            Have a Question?<br />
            <span class="text-gradient">We'd Love to Hear From You.</span>
          </h2>
          <p class="contact__sub">
            Whether you're just getting started on Amazon or scaling a 7-figure brand, we're here to help. Send us a message and our team will get back to you within 24 hours.
          </p>

          <div class="contact__info">
            <a href="mailto:hello@rankaztactics.com" class="contact__info-item">
              <span class="contact__info-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <span>hello@rankaztactics.com</span>
            </a>
            <a href="/#calendly" class="contact__info-item">
              <span class="contact__info-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </span>
              <span>Or book a free strategy call →</span>
            </a>
          </div>
        </div>

        <!-- Right: Tally Form Embed -->
        <div class="contact__form">
          <div class="contact__tally-wrapper">
            <iframe
              src="https://tally.so/embed/WObbGP?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
              width="100%"
              height="100%"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Contact Form"
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--navbar-h); /* always clears the fixed navbar, updates automatically on mobile */
    overflow: hidden;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hero__orb--1 {
    position: absolute;
    top: -200px;
    left: -200px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.12) 0%, transparent 70%);
    animation: glow-pulse 6s ease-in-out infinite;
    pointer-events: none;
  }

  .hero__orb--2 {
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.07) 0%, transparent 70%);
    animation: glow-pulse 8s ease-in-out infinite reverse;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__headline {
    font-size: clamp(2.6rem, 5.5vw, 4.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .hero__sub {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 500px;
    margin-bottom: 36px;
  }

  .hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero__stat-value {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--accent-primary);
  }

  .hero__stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Video */
  .hero__video {
    position: relative;
    z-index: 1;
  }

  .hero__video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 */
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-card);
    box-shadow: var(--shadow-card), 0 0 0 1px var(--border-subtle);
  }

  .hero__video-wrapper iframe,
  .hero__video-wrapper .video-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__video-glow {
    position: absolute;
    inset: -20px;
    border-radius: var(--radius-xl);
    background: radial-gradient(ellipse, rgba(245, 158, 11, 0.15), transparent 70%);
    z-index: -1;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  /* Video Placeholder */
  .video-placeholder {
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-placeholder__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 32px;
    text-align: center;
  }

  .video-placeholder__play {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-glow));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #08080f;
    box-shadow: 0 0 40px rgba(245, 158, 11, 0.4);
    animation: float 3s ease-in-out infinite;
  }

  .video-placeholder__label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .video-placeholder__hint {
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 280px;
    margin: 0;
  }

  .video-placeholder__hint code {
    display: block;
    margin-top: 8px;
    padding: 8px 12px;
    background: var(--bg-base);
    border-radius: var(--radius-sm);
    font-family: monospace;
    color: var(--accent-glow);
    font-size: 0.65rem;
    word-break: break-all;
  }

  /* ---- Services ---- */
  .services {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .services__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .services__sub {
    max-width: 560px;
    margin: 16px auto 0;
    font-size: 1rem;
    line-height: 1.75;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .service-card {
    padding: 28px;
  }

  .service-card__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    margin-bottom: 20px;
  }

  .service-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .service-card__desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ---- Team ---- */
  .team-section {
    background: var(--bg-base);
  }

  .team__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .team__sub {
    max-width: 480px;
    margin: 16px auto 0;
    font-size: 1rem;
    line-height: 1.75;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }

  .team-card__photo-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .team-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.4s ease;
  }

  .team-card:hover .team-card__photo {
    transform: scale(1.04);
  }

  .team-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .team-card__name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .team-card__title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .team-card__desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 4px 0 0;
  }

  /* ---- Calendly ---- */
  .calendly-section {
    background: var(--bg-base);
  }

  .calendly__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

